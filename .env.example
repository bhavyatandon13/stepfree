# Copy this file to .env.local and paste your OpenRouter key after the = sign.
# .env.local is git-ignored. Never commit a real key.
OPENROUTER_API_KEY=
# Optional: pick a different model
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# "Write to us" form (see README, section "Write to us form")
# Supabase: Project Settings -> API. Use the service_role key; it stays on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Gmail that sends the emails, with a Google "App password" (not your normal password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where new-message alerts go (defaults to GMAIL_USER)
NOTIFY_EMAIL=
